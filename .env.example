# Never commit real credentials.
# Etsy Open API v3
ETSY_API_KEY=
ETSY_SHARED_SECRET=
# Set this to the exact production callback registered in Etsy "Your Apps".
# Example: https://your-project.vercel.app/api/etsy/oauth/callback
ETSY_REDIRECT_URI=
# Optional but recommended: exact expected shop ID for Shop Identity Test.
ETSY_SHOP_ID=

# Persistent encrypted OAuth token storage.
# DATABASE_URL must point to the dedicated AutoDigitalPublisher PostgreSQL database.
DATABASE_URL=
# Use a unique secret of at least 32 characters. Never reuse the Etsy shared secret.
TOKEN_ENCRYPTION_KEY=

# Etsy webhook verification. Obtain the whsec_ value from Etsy's Webhook Portal.
# Do not activate a live subscription until production readiness is verified.
ETSY_WEBHOOK_SIGNING_SECRET=
# Optional bounded tolerance in seconds. Runtime clamps this to 60..600; default 300.
ETSY_WEBHOOK_TOLERANCE_SECONDS=300

GUMROAD_ACCESS_TOKEN=
PAYHIP_API_KEY=

# Non-production Etsy writes are independently gated.
# Keep false until the Draft-first adapter candidate passes CI + Preview QC.
ETSY_DRAFT_WRITES_ENABLED=false
# Required whenever ETSY_DRAFT_WRITES_ENABLED=true.
# Send it only as the x-autodigitalpublisher-write-token request header.
ETSY_DRAFT_WRITE_TOKEN=

# Independent bearer credential for the read-only exact Listing Sales API.
# Do not reuse any Etsy or production write token.
ETSY_SALES_READ_TOKEN=

# Independent bearer credential for authenticated read-only Product 04-15 reconciliation.
# Keep separate from Etsy OAuth tokens and every marketplace write token.
ETSY_RECONCILIATION_READ_TOKEN=

# Live marketplace state changes remain disabled unless separately authorized.
PUBLISH_WRITES_ENABLED=false

# Exact canonical request hash allowlist for the one-shot B01 active-listing update.
# The dedicated route fails closed when this value is absent or the request differs.
ETSY_ACTIVE_UPDATE_B01_REQUEST_SHA256=

# Public commerce analytics. These values are safe to expose to the browser.
# Analytics bootstrap is restricted to NEXT_PUBLIC_ANALYTICS_PUBLIC_PATH_PREFIXES;
# current admin/control-center routes remain excluded by default.
NEXT_PUBLIC_ANALYTICS_PUBLIC_PATH_PREFIXES=/products,/p
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Server-side Meta Conversions API credentials are intentionally not public env vars.
META_CAPI_ACCESS_TOKEN=
META_CAPI_DATASET_ID=

# Exact PDT-BOBA-001 B01 description-only one-shot authorization binding.
ETSY_BOBA_B01_DESCRIPTION_AUTHORIZATION_ID=
ETSY_BOBA_B01_DESCRIPTION_REQUEST_SHA256=

# Exact PD-REST-003 A01 historical binding. Never reuse.
ETSY_PD_REST_003_A01_AUTHORIZATION_ID=
ETSY_PD_REST_003_A01_REQUEST_SHA256=

# Exact PD-REST-003 B01 title+ordered-tags one-shot authorization binding.
ETSY_PD_REST_003_B01_AUTHORIZATION_ID=
ETSY_PD_REST_003_B01_REQUEST_SHA256=

# Exact PDT-POGO-001 B01 title+ordered-tags one-shot authorization binding.
# Leave both unset while using verify_protected_state staging.
ETSY_PDT_POGO_001_B01_AUTHORIZATION_ID=
ETSY_PDT_POGO_001_B01_REQUEST_SHA256=

# Exact PD-STOCK-005 C01 fresh title+ordered-tags one-shot authorization binding.
# Leave unset for zero-write verify_protected_state staging.
ETSY_PD_STOCK_005_C01_AUTHORIZATION_ID=
ETSY_PD_STOCK_005_C01_REQUEST_SHA256=

# Chat -> Google Drive -> Etsy Draft asset bridge. Never commit credentials.
# Connect a dedicated read-only Google service account to the exact canonical
# Drive product root (share files/folder with its client_email).
# ChatGPT's Google Drive connection does NOT provide Vercel with Drive OAuth.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_SOURCE_ROOT_ID=

# Bridge is always OFF unless specifically approved for an exact Product/Candidate/Draft.
# This is independent of ETSY_DRAFT_WRITES_ENABLED and PUBLISH_WRITES_ENABLED.
ETSY_DRIVE_ASSET_WRITES_ENABLED=false
ETSY_DRIVE_APPROVED_PRODUCT_ID=
ETSY_DRIVE_APPROVED_CANDIDATE_FINGERPRINT=
ETSY_DRIVE_APPROVED_DRAFT_LISTING_ID=

# Generic Etsy metadata Draft creation, independently OFF.
# Requires existing Etsy scope listings_r/listings_w and independently approved Product Plan.
ETSY_GENERIC_DRAFT_WRITES_ENABLED=false
ETSY_GENERIC_DRAFT_APPROVED_PRODUCT_ID=
ETSY_GENERIC_DRAFT_APPROVED_CANDIDATE_FINGERPRINT=
ETSY_GENERIC_DRAFT_APPROVED_LISTING_FINGERPRINT=

# Reviewer-confirmed current QC evidence (no caller may self-attest for marketplace writes).
# Populate only after an independent reviewer verified all current source files,
# exact bytes/hashes, tester pass, final QC pass and canonical Drive report.
# Server pins are NOT a replacement for independent QC; reviewer documents the evidence.
ETSY_QC_APPROVED_PRODUCT_ID=
ETSY_QC_APPROVED_CANDIDATE_FINGERPRINT=
ETSY_QC_APPROVED_LISTING_FINGERPRINT=
ETSY_QC_APPROVED_REPORT_SHA256=
ETSY_QC_APPROVED_REPORT_DRIVE_ID=

# Release checkpoint. All write gates default OFF; requires exact seller approval.
# Asset-set fingerprint is produced by read-only /api/etsy/release PREFLIGHT.
ETSY_EXACT_PUBLISH_WRITES_ENABLED=false
ETSY_EXACT_PUBLISH_PRODUCT_ID=
ETSY_EXACT_PUBLISH_CANDIDATE_FINGERPRINT=
ETSY_EXACT_PUBLISH_DRAFT_ID=
ETSY_EXACT_PUBLISH_ASSET_SET_SHA256=
ETSY_EXACT_PUBLISH_AUTHORIZATION_ID=

# Direct ChatGPT/Work Google Drive transfer; NO Google Service Account needed.
# Operator streams exact PDF/JPG/PNG/ZIP bytes via authenticated multipart POST.
# Must be true in addition to ETSY_DRAFT_WRITES_ENABLED for exact approved asset.
ETSY_CHAT_ASSET_WRITES_ENABLED=false
ETSY_CHAT_APPROVED_PRODUCT_ID=
ETSY_CHAT_APPROVED_CANDIDATE_FINGERPRINT=
ETSY_CHAT_APPROVED_DRAFT_LISTING_ID=
# JSON manifest reviewed server-side: rootId, productId,
# candidateFingerprint, expectedListingFingerprint, assets[{driveFileId,
# assetName, expectedSha256, expectedBytes, kind, rank}].
ETSY_CHAT_APPROVED_ASSETS_JSON=
