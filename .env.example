# Never commit real credentials.
# Etsy Open API v3
ETSY_API_KEY=
ETSY_SHARED_SECRET=
# Set this to the exact production callback registered in Etsy "Your Apps".
# Example: https://your-project.vercel.app/api/etsy/oauth/callback
ETSY_REDIRECT_URI=
# Optional but recommended: exact expected shop ID for Shop Identity Test.
ETSY_SHOP_ID=

# Persistent encrypted OAuth token storage.
# DATABASE_URL must point to the dedicated AutoDigitalPublisher PostgreSQL database.
DATABASE_URL=
# Use a unique secret of at least 32 characters. Never reuse the Etsy shared secret.
TOKEN_ENCRYPTION_KEY=

GUMROAD_ACCESS_TOKEN=
PAYHIP_API_KEY=

# Keep false until authenticated marketplace adapters are fully verified.
PUBLISH_WRITES_ENABLED=false
